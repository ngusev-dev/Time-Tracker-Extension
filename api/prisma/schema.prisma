generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  password     String
  firstName    String
  lastName     String
  middleName   String?
  login        String
  createdAt    DateTime       @default(now())
  timerHistory TimerHistory[]
  userTimer    UserTimer?
  token        Token?
  role         UserRole       @default(MEMBER)

  @@map("users")
}

model UserTimer {
  id                 Int         @id @default(autoincrement())
  startTimer         DateTime?
  status             TimerStatus @default(NEW)
  userId             Int         @unique
  totalTimeInSeconds Float       @default(0)
  endTimer           DateTime?
  description        String?
  timerId            String      @unique @default(uuid()) @db.Uuid
  taskTypeId         String?     @db.Uuid
  user               User        @relation(fields: [userId], references: [id])
  taskType           TaskType?   @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)

  @@map("userTimers")
}

model TimerHistory {
  id                 Int       @id @default(autoincrement())
  startTimer         DateTime
  endTimer           DateTime
  userId             Int
  totalTimeInSeconds Float
  description        String?
  timerId            String    @db.Uuid
  taskTypeId         String?   @db.Uuid
  user               User      @relation(fields: [userId], references: [id])
  taskType           TaskType? @relation(fields: [taskTypeId], references: [id], onDelete: SetNull)

  @@index([taskTypeId])
  @@map("timerHistories")
}

model TaskType {
  id       String         @id @default(uuid()) @db.Uuid
  parentId String?        @db.Uuid
  name     String

  color    String?
  parent   TaskType?      @relation("TaskTypeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children TaskType[]     @relation("TaskTypeTree")
  timers   UserTimer[]
  history  TimerHistory[]

  @@index([parentId])
  @@map("taskTypes")
}

model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

model Token {
  id        Int       @id @default(autoincrement())
  token     String
  expiresIn DateTime
  type      TokenType
  code      Int?
  attempts  Int       @default(0)

  email  String @unique
  user   User   @relation(fields: [userId], references: [id])
  userId Int    @unique

  @@map("tokens")
}

enum TokenType {
  RESET_PASSWORD
}

enum TimerStatus {
  NEW
  WORKING
  PAUSE
}

enum UserRole {
  MEMBER
  ADMIN
}
